    <style name="Theme.HelioLAN" parent="Base.Theme.HelioLAN" />

    <style name="Theme.HelioLAN.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/md_theme_dark_primaryContainer</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/avd_splash_jump_rope</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/md_theme_dark_primaryContainer</item>
        <item name="windowSplashScreenAnimationDuration">1200</item>
        <item name="postSplashScreenTheme">@style/Theme.HelioLAN</item>
    </style>
</resources>
