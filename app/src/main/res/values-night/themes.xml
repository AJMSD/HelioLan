        <item name="colorSurfaceContainerHighest">@color/md_theme_dark_surfaceVariant</item>
        <item name="colorSurfaceBright">@color/md_theme_dark_surface</item>
        <item name="colorSurfaceDim">@color/md_theme_dark_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/md_theme_dark_onSurfaceVariant</item>
        <item name="colorOutline">@color/md_theme_dark_outline</item>
        <item name="colorOutlineVariant">@color/md_theme_dark_outline</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:forceDarkAllowed">false</item>
